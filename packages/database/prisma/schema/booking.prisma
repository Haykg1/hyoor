// Bookings

enum BookingStatus {
  AWAITING_PAYMENT
  PENDING
  CONFIRMED
  CANCELLED_BY_GUEST
  CANCELLED_BY_HOST
  PAYMENT_EXPIRED
  COMPLETED
  NO_SHOW
}

enum PaymentProvider {
  STRIPE
  IDRAM
  ARCA
  CASH
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum DepositStatus {
  NONE
  AUTHORIZED
  RELEASED
  CAPTURED
  FAILED
}

enum PayoutStatus {
  NONE
  SCHEDULED
  PAID
  FAILED
}

enum SecurityDepositClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CancellationFeeClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentFailureCategory {
  RENT_CAPTURE_FAILED
  DEPOSIT_RELEASE_FAILED
  DEPOSIT_CLAIM_TRANSFER_FAILED
  PAYOUT_TRANSFER_FAILED
  PAYMENT_LOCK_SWEEP_FAILED
  CANCELLATION_CAPTURE_FAILED
}

model Booking {
  id                           String           @id @default(cuid())
  propertyId                   String
  guestId                      String
  status                       BookingStatus    @default(PENDING)
  checkIn                      DateTime         @db.Date
  checkOut                     DateTime         @db.Date
  guestCount                   Int
  specialRequests              String?
  currency                     String
  nightlyRate                  Int
  nightsCount                  Int
  /// Per-night prices at booking time: [{ date: "YYYY-MM-DD", amount: number }, ...]
  nightlyBreakdown             Json?
  cleaningFee                  Int              @default(0)
  securityDeposit              Int              @default(0)
  discountAmount               Int              @default(0)
  promotionId                  String?
  totalAmount                  Int
  paymentProvider              PaymentProvider?
  paymentStatus                PaymentStatus    @default(UNPAID)
  paymentInitiatedAt           DateTime?
  paymentCompletedAt           DateTime?
  externalPaymentRef           String?
  paymentLockExpiresAt         DateTime?
  stripePaymentIntentId        String?
  stripeDepositPaymentIntentId String?
  depositStatus                DepositStatus    @default(NONE)
  capturedAt                   DateTime?
  platformFeeAmount            Int?
  hostPayoutAmount             Int?
  stripeTransferId             String?
  payoutStatus                 PayoutStatus     @default(NONE)
  payoutScheduledAt            DateTime?
  refundedAmount               Int              @default(0)
  cancellationReason           String?
  cancelledAt                  DateTime?
  guestInstructionsSentAt      DateTime?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  property             Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest                User                  @relation("GuestBookings", fields: [guestId], references: [id], onDelete: Restrict)
  promotion            PropertyPromotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  reviews              Review[]
  securityDepositClaim SecurityDepositClaim?
  cancellationFeeClaim CancellationFeeClaim?
  paymentFailures      PaymentFailure[]

  @@index([propertyId])
  @@index([propertyId, checkIn])
  @@index([promotionId])
  @@index([guestId])
  @@index([checkIn])
  @@index([checkIn, status])
  @@index([checkOut])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentLockExpiresAt])
  @@index([payoutStatus])
  @@map("bookings")
}

model SecurityDepositClaim {
  id               String                     @id @default(cuid())
  bookingId        String                     @unique
  hostUserId       String
  amount           Int
  reason           String                     @db.Text
  evidenceKeys     String[]                   @default([])
  status           SecurityDepositClaimStatus @default(PENDING)
  reviewedByUserId String?
  reviewNote       String?
  stripeTransferId String?
  createdAt        DateTime                   @default(now())
  reviewedAt       DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("security_deposit_claims")
}

model CancellationFeeClaim {
  id               String                     @id @default(cuid())
  bookingId        String                     @unique
  hostUserId       String
  amount           Int
  reason           String?                    @db.Text
  status           CancellationFeeClaimStatus @default(PENDING)
  reviewedByUserId String?
  reviewNote       String?
  createdAt        DateTime                   @default(now())
  reviewedAt       DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("cancellation_fee_claims")
}

model PaymentFailure {
  id               String                 @id @default(cuid())
  bookingId        String
  category         PaymentFailureCategory
  message          String                 @db.Text
  stripeErrorCode  String?
  resolved         Boolean                @default(false)
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime               @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([category])
  @@index([resolved])
  @@map("payment_failures")
}
