// Bookings

enum BookingStatus {
  AWAITING_PAYMENT
  PENDING
  CONFIRMED
  CANCELLED_BY_GUEST
  CANCELLED_BY_HOST
  PAYMENT_EXPIRED
  COMPLETED
  NO_SHOW
}

enum PaymentProvider {
  IDRAM
  ARCA
  CASH
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentFailureCategory {
  PAYMENT_LOCK_SWEEP_FAILED
}

model Booking {
  id                      String           @id @default(cuid())
  propertyId              String
  guestId                 String
  status                  BookingStatus    @default(PENDING)
  checkIn                 DateTime         @db.Date
  checkOut                DateTime         @db.Date
  guestCount              Int
  specialRequests         String?
  currency                String
  nightlyRate             Int
  nightsCount             Int
  /// Per-night prices at booking time: [{ date: "YYYY-MM-DD", amount: number }, ...]
  nightlyBreakdown        Json?
  cleaningFee             Int              @default(0)
  securityDeposit         Int              @default(0)
  discountAmount          Int              @default(0)
  promotionId             String?
  totalAmount             Int
  paymentProvider         PaymentProvider?
  paymentStatus           PaymentStatus    @default(UNPAID)
  paymentInitiatedAt      DateTime?
  paymentCompletedAt      DateTime?
  externalPaymentRef      String?
  paymentLockExpiresAt    DateTime?
  capturedAt              DateTime?
  platformFeeAmount       Int?
  hostPayoutAmount        Int?
  refundedAmount          Int              @default(0)
  cancellationReason      String?
  cancelledAt             DateTime?
  guestInstructionsSentAt DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest           User               @relation("GuestBookings", fields: [guestId], references: [id], onDelete: Restrict)
  promotion       PropertyPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  reviews         Review[]
  paymentFailures PaymentFailure[]

  @@index([propertyId])
  @@index([propertyId, checkIn])
  @@index([promotionId])
  @@index([guestId])
  @@index([checkIn])
  @@index([checkIn, status])
  @@index([checkOut])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentLockExpiresAt])
  @@map("bookings")
}

model PaymentFailure {
  id               String                 @id @default(cuid())
  bookingId        String
  category         PaymentFailureCategory
  message          String                 @db.Text
  resolved         Boolean                @default(false)
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime               @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([category])
  @@index([resolved])
  @@map("payment_failures")
}
